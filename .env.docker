# Settings for the local Docker stack, read by both docker-compose.yml and
# the Makefile. Development values only.
#
# These are exported by the Makefile and therefore win over
# tracking-backend/.env, because godotenv does not overwrite variables that
# are already set in the environment.

# --- Postgres -------------------------------------------------------------
# 5433, not 5432: this machine already runs a native PostgreSQL on 5432.
#
# 127.0.0.1, not "localhost": docker-compose publishes these ports on the
# IPv4 loopback only, while "localhost" resolves to ::1 first on Windows.
# That produced a "connection refused" that looked like the container was
# down when it was running perfectly.
DB_HOST=127.0.0.1
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=tracking_db
DB_SSLMODE=disable

# --- Redis ----------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# --- MQTT -----------------------------------------------------------------
# The local Mosquitto container allows anonymous connections, so the
# username and password are ignored; they are set to match production shape.
MQTT_BROKER=tcp://127.0.0.1:1883
MQTT_USER=testquitto
MQTT_PASSWORD=admin
MQTT_TOPIC=devices/+/location
MQTT_PORT=1883
MQTT_WS_PORT=8083

# --- JWT ------------------------------------------------------------------
# Development key. Production requires a real one; see VPS/deploy.sh.
JWT_SECRET=local-development-only-jwt-signing-key-32chars
JWT_EXPIRY_HOURS=72

# --- Server ---------------------------------------------------------------
SERVER_PORT=8080
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Maps -----------------------------------------------------------------
# Directory holding config.json, the .mbtiles, styles/ and fonts/.
# Quoted because the path contains a space and this file is also sourced by
# the shell scripts in scripts/.
MAPS_DIR="D:/Abolfazl Keshavarz/maps"
TILESERVER_PORT=8081

# --- Trip certificates ------------------------------------------------------
# Ed25519 private key used to sign trip certificates (base64). Development
# value; generate a fresh one per environment with: cli cert-keygen
# The matching public key is served at GET /api/certificate-key.
CERT_SIGNING_KEY=aOEMpvy70OMuBeWcagN2VvPAZjkwbgxE04vjAK4UzUj7MQjuFEEojYFCYtGCQRiyIsCje8zOTGlyb7QmKhRU/Q==

# --- Web Push -------------------------------------------------------------
# VAPID key pair for browser notifications (base64url). Development values;
# generate a fresh pair per environment with: make vapid-keygen
# The public half is served at GET /api/push/vapid-key.
#
# These must live here rather than in tracking-backend/.env: the Makefile
# exports every variable it knows about, and an exported-but-empty one still
# counts as set, which stops godotenv loading the real value from .env.
VAPID_PUBLIC_KEY=BEA613GAqxo68aqTqnPCHBAvByC7Syaf1QI3tZNv293g9KmuctwYGu64SrHwdQ_8BqLr7JYCdlRmg6W2r2EUca0
VAPID_PRIVATE_KEY=gjc6Riz6VloS2Z0nNN7nD27HEX-pCv0sI_Mnw-hBGNU
VAPID_SUBJECT=mailto:support@localhost
