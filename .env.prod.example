# Production environment for docker-compose.prod.yml.
#
#   cp .env.prod.example .env.prod
#   # edit every CHANGE_ME below
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
#
# .env.prod is gitignored. Never commit real values.

# --- Database -------------------------------------------------------------
DB_USER=tracking
DB_PASSWORD=CHANGE_ME_strong_database_password
DB_NAME=tracking_db
DB_SSLMODE=disable

# --- Redis ----------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME_strong_redis_password

# --- MQTT -----------------------------------------------------------------
# These must match the credentials flashed into the device firmware.
MQTT_USER=tracker
MQTT_PASSWORD=CHANGE_ME_strong_mqtt_password
MQTT_TOPIC=devices/+/location
MQTT_PORT=1883

# --- JWT ------------------------------------------------------------------
# REQUIRED, minimum 32 characters. The backend refuses to start otherwise.
#   openssl rand -base64 48
JWT_SECRET=CHANGE_ME_at_least_32_characters_long_random_string
JWT_EXPIRY_HOURS=72

# --- Web ------------------------------------------------------------------
HTTP_PORT=80
APP_DOMAIN=example.com
PUBLIC_URL=https://example.com
# Browser origins allowed for CORS and WebSocket upgrades, comma separated.
ALLOWED_ORIGINS=https://example.com,https://www.example.com

# --- Maps -----------------------------------------------------------------
# Absolute path to the directory holding config.json, the .mbtiles, styles/
# and fonts/. On the server this is typically /root/maps.
MAPS_DIR=/root/maps

# --- Misc -----------------------------------------------------------------
TZ=Asia/Tehran
VERSION=1.0.0
