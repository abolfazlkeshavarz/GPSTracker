# Production environment for docker-compose.prod.yml.
#
#   cp .env.prod.example .env.prod
#   # edit every CHANGE_ME below
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
#
# .env.prod is gitignored. Never commit real values.

# --- Database -------------------------------------------------------------
DB_USER=tracking
DB_PASSWORD=CHANGE_ME_strong_database_password
DB_NAME=tracking_db
DB_SSLMODE=disable

# --- Redis ----------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME_strong_redis_password

# --- MQTT -----------------------------------------------------------------
# These must match the credentials flashed into the device firmware.
MQTT_USER=tracker
MQTT_PASSWORD=CHANGE_ME_strong_mqtt_password
MQTT_TOPIC=devices/+/location
MQTT_PORT=1883

# --- JWT ------------------------------------------------------------------
# REQUIRED, minimum 32 characters. The backend refuses to start otherwise.
#   openssl rand -base64 48
JWT_SECRET=CHANGE_ME_at_least_32_characters_long_random_string
JWT_EXPIRY_HOURS=72

# --- Web ------------------------------------------------------------------
# Loopback-only port the frontend container publishes on (see
# docker-compose.prod.yml). The host's nginx (scripts/deploy-host-nginx.sh)
# is what the public actually reaches, on 80/443, so this only needs to be
# unique if another project's stack is already using it on the same host.
HTTP_PORT=8081
APP_DOMAIN=example.com
PUBLIC_URL=https://example.com
# Browser origins allowed for CORS and WebSocket upgrades, comma separated.
ALLOWED_ORIGINS=https://example.com,https://www.example.com

# --- Trip certificates ------------------------------------------------------
# Ed25519 private key for signing trip certificates. Generate with:
#   docker compose -f docker-compose.prod.yml exec backend /app/cli cert-keygen
# Leave empty to disable certificate issuing (verification of already-issued
# documents still works, since that only needs the embedded public key).
#
# Rotating this invalidates verification of every certificate already issued,
# so publish the old public key alongside the new one.
CERT_SIGNING_KEY=

# --- Maps -----------------------------------------------------------------
# Absolute path to the directory holding config.json, the .mbtiles, styles/
# and fonts/. On the server this is typically /root/maps.
MAPS_DIR=/root/maps

# --- Misc -----------------------------------------------------------------
TZ=Asia/Tehran
VERSION=1.0.0

# ---------------------------------------------------------------- Web Push
# Generate with: make vapid-keygen (or `docker compose run --rm backend /app/cli vapid-keygen`)
# Rotating these invalidates every existing browser subscription.
VAPID_PUBLIC_KEY=CHANGE_ME
VAPID_PRIVATE_KEY=CHANGE_ME
VAPID_SUBJECT=mailto:support@your-domain

# Reverse proxies whose X-Forwarded-For header the backend believes
# (comma-separated IPs/CIDRs). Anything else is ignored, so clients cannot
# spoof their IP to dodge the login rate limiter.
TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12

# --- Host nginx / TLS (scripts/deploy-host-nginx.sh, `make ssl`) ----------
# Not read by the containers — only by the host-nginx setup script, which
# terminates TLS in front of the loopback-only frontend container.
LETSENCRYPT_EMAIL=admin@example.com
LETSENCRYPT_STAGING=false
