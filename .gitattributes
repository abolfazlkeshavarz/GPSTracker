# Line endings.
#
# On Windows, git's autocrlf and several editors will happily rewrite these
# files with CRLF. bash then fails on the trailing \r with errors like
#   scripts/health.sh: line 33: $'\r': command not found
# which look nothing like a line-ending problem. Pin them to LF.

* text=auto

# Anything executed by a shell must be LF, including inside containers.
*.sh            text eol=lf
Makefile        text eol=lf
*.mk            text eol=lf
Dockerfile      text eol=lf
*.conf          text eol=lf
*.sql           text eol=lf
.env.example    text eol=lf
.env.docker     text eol=lf
.env.prod.example text eol=lf

# Windows-only helpers stay CRLF.
*.bat           text eol=crlf
*.cmd           text eol=crlf
*.ps1           text eol=crlf

# Binary assets: never touch.
*.png           binary
*.ico           binary
*.ttf           binary
*.mbtiles       binary
*.pbf           binary
