# Sets Connection: upgrade only on a real WebSocket handshake, matching the
# map in tracking-frontend/nginx.conf. Hard-coding "upgrade" for every
# request would leave ordinary HTTP/1.1 connections unable to be reused.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    # http2 on the listen line, not a separate `http2 on;` directive: that
    # form only exists from nginx 1.25.1 onward, and the version Ubuntu
    # actually packages (apt install nginx) is older and rejects it with
    # "unknown directive". This classic form works everywhere back to 1.9.5.
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;

    # Devices flash their tracker secret over MQTT, not this endpoint, but a
    # confused device or a script kiddie's scanner can still send an
    # oversized body; the frontend container already caps this too, this is
    # just the outer line of defence.
    client_max_body_size 2m;

    # Everything else — security headers, gzip, the API/WebSocket proxy, the
    # SPA fallback — is handled by the frontend container's own nginx
    # (tracking-frontend/nginx.conf). This vhost's only job is TLS
    # termination and forwarding.
    location / {
        proxy_pass http://127.0.0.1:${APP_HTTP_PORT};
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket upgrade for the live-tracking socket. The map lives in
        # the frontend container's nginx.conf; harmless to set unconditionally.
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_read_timeout 75s;
    }
}
