# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=tracking_db
DB_SSLMODE=disable

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MQTT
MQTT_BROKER=tcp://localhost:1883
MQTT_USER=change-me
MQTT_PASSWORD=change-me
MQTT_TOPIC=devices/+/location

# JWT - REQUIRED in production, must be >= 32 chars.
# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRY_HOURS=72

# Server
SERVER_PORT=8080

# Extra browser origins allowed for CORS and WebSocket (comma separated)
ALLOWED_ORIGINS=

# Environment: development | production
APP_ENV=development
