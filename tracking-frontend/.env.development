# Vite development settings. Loaded automatically by `npm run dev`.
# Only VITE_-prefixed variables are exposed to the browser bundle.

# Backend the /api proxy forwards to (see vite.config.ts).
VITE_API_TARGET=http://localhost:8080

# Local tileserver-gl from docker-compose. Without this the map falls back to
# the production host, which needs internet access to maps.abolfazl.fun.
VITE_MAP_STYLE_URL=http://localhost:8081/styles/osm-bright/style.json
