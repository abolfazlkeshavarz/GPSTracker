{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    // A composite project must emit, and by default it emitted vite.config.js
    // right next to vite.config.ts. Vite resolves vite.config.js first, so
    // that stale compiled copy shadowed the real config and silently
    // discarded any change made to it. Park the output out of the way.
    "outDir": "./node_modules/.tmp/tsconfig.node",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node/tsconfig.node.tsbuildinfo"
  },
  "include": ["vite.config.ts"]
}