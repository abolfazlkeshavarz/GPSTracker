{
  // The service worker runs in a different global scope to the app: `self` is
  // a ServiceWorkerGlobalScope, and `window`/`document` do not exist. Checking
  // it under the app's DOM lib produces nonsense errors, so it gets its own
  // project with the WebWorker lib instead.
  "compilerOptions": {
    "composite": true,
    "target": "ES2020",
    "lib": ["ES2020", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["vite/client", "vite-plugin-pwa/client"],
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": false,
    // Composite projects must emit; park the output out of the source tree so
    // a stale sw.js cannot shadow sw.ts (the same trap tsconfig.node.json
    // documents for vite.config).
    "outDir": "./node_modules/.tmp/tsconfig.worker",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker/tsconfig.worker.tsbuildinfo"
  },
  "include": ["src/sw.ts"]
}
